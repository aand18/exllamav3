import matplotlib.pyplot as plt
import matplotlib.patches as patches
import numpy as np

def draw_cute_kitten():
    """Draw a cute cartoon-style kitten using matplotlib."""
    fig, ax = plt.subplots(figsize=(8, 8))
    ax.set_xlim(0, 10)
    ax.set_ylim(0, 10)
    ax.set_aspect('equal')
    ax.axis('off')
    
    # Background
    ax.set_facecolor('#f0f8ff')
    fig.patch.set_facecolor('#f0f8ff')
    
    # Body (oval)
    body = patches.Ellipse((5, 3.5), width=4, height=3, facecolor='#8B7355', edgecolor='#5C4033', linewidth=2)
    ax.add_patch(body)
    
    # Head (circle)
    head = patches.Circle((5, 6.5), radius=1.8, facecolor='#8B7355', edgecolor='#5C4033', linewidth=2)
    ax.add_patch(head)
    
    # Left ear (triangle)
    left_ear = patches.Polygon([[3.8, 7.5], [3.2, 8.5], [4.5, 7.8]], closed=True, facecolor='#8B7355', edgecolor='#5C4033', linewidth=2)
    ax.add_patch(left_ear)
    
    # Right ear (triangle)
    right_ear = patches.Polygon([[6.2, 7.5], [6.8, 8.5], [5.5, 7.8]], closed=True, facecolor='#8B7355', edgecolor='#5C4033', linewidth=2)
    ax.add_patch(right_ear)
    
    # Inner left ear (pink)
    inner_left_ear = patches.Polygon([[3.9, 7.6], [3.5, 8.2], [4.4, 7.7]], closed=True, facecolor='#FFB6C1', edgecolor='none')
    ax.add_patch(inner_left_ear)
    
    # Inner right ear (pink)
    inner_right_ear = patches.Polygon([[6.1, 7.6], [6.5, 8.2], [5.6, 7.7]], closed=True, facecolor='#FFB6C1', edgecolor='none')
    ax.add_patch(inner_right_ear)
    
    # Eyes (white circles with black pupils)
    left_eye_white = patches.Circle((4.3, 6.8), radius=0.35, facecolor='white', edgecolor='black', linewidth=1)
    ax.add_patch(left_eye_white)
    left_pupil = patches.Circle((4.3, 6.8), radius=0.15, facecolor='black')
    ax.add_patch(left_pupil)
    
    right_eye_white = patches.Circle((5.7, 6.8), radius=0.35, facecolor='white', edgecolor='black', linewidth=1)
    ax.add_patch(right_eye_white)
    right_pupil = patches.Circle((5.7, 6.8), radius=0.15, facecolor='black')
    ax.add_patch(right_pupil)
    
    # Eye highlights (small white dots)
    left_highlight = patches.Circle((4.2, 6.9), radius=0.05, facecolor='white')
    ax.add_patch(left_highlight)
    right_highlight = patches.Circle((5.6, 6.9), radius=0.05, facecolor='white')
    ax.add_patch(right_highlight)
    
    # Nose (small triangle)
    nose = patches.Polygon([[5, 6.3], [4.85, 6.1], [5.15, 6.1]], closed=True, facecolor='#FFB6C1', edgecolor='#5C4033', linewidth=1)
    ax.add_patch(nose)
    
    # Mouth (smile curve)
    theta = np.linspace(0, np.pi, 50)
    mouth_x = 5 + 0.3 * np.cos(theta)
