Here is a Python script that draws a cute, stylized cartoon kitten using `matplotlib`. It uses basic geometric shapes (circles, ellipses, and lines) to construct the face, ears, eyes, and whiskers.

### Prerequisites
You need to install `matplotlib` if you haven't already:
```bash
pip install matplotlib
```

### Python Script

```python
import matplotlib.pyplot as plt
import matplotlib.patches as patches
import numpy as np

def draw_cute_kitten():
    # Create a figure and axis
    fig, ax = plt.subplots(figsize=(8, 8))
    ax.set_aspect('equal')
    ax.axis('off')  # Hide the axes
    ax.set_xlim(-10, 10)
    ax.set_ylim(-10, 10)
    
    # Background color (optional, light blue for sky)
    ax.set_facecolor('#E0F7FA')

    # --- 1. Head (Main Circle) ---
    head = patches.Circle((0, 0), radius=6, facecolor='#FFD700', edgecolor='black', linewidth=2)
    ax.add_patch(head)

    # --- 2. Ears (Triangles) ---
    # Left Ear
    left_ear = patches.Polygon([(-4, 4), (-6, 8), (-2, 6)], closed=True, facecolor='#FFD700', edgecolor='black', linewidth=2)
    ax.add_patch(left_ear)
    # Inner Left Ear (Pink)
    left_inner_ear = patches.Polygon([(-4, 4.5), (-5, 7), (-3, 5.5)], closed=True, facecolor='#FFB6C1', edgecolor='none')
    ax.add_patch(left_inner_ear)

    # Right Ear
    right_ear = patches.Polygon([(4, 4), (6, 8), (2, 6)], closed=True, facecolor='#FFD700', edgecolor='black', linewidth=2)
    ax.add_patch(right_ear)
    # Inner Right Ear (Pink)
    right_inner_ear = patches.Polygon([(4, 4.5), (5, 7), (3, 5.5)], closed=True, facecolor='#FFB6C1', edgecolor='none')
    ax.add_patch(right_inner_ear)

    # --- 3. Eyes ---
    # Left Eye
    left_eye = patches.Ellipse((-2.5, 1), width=1.5, height=2, facecolor='white', edgecolor='black', linewidth=1.5)
    ax.add_patch(left_eye)
