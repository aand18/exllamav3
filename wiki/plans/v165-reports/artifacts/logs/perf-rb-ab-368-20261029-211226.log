    # Provides summary information about pipeline state

    def summary(self) -> dict[str, Any]:
        """
        Returns a summary dict for logging/reporting.
        
        Returns:
            Dict with pipeline name, stage count, status per stage, and metadata
        """
        return {
            "pipeline": self.name,
