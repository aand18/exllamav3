# ---------------------------------------------------------------------------
# Domain enums & value objects
# ---------------------------------------------------------------------------

class StageStatus(Enum):
    """Tracks the lifecycle state of a pipeline stage during execution."""
    PENDING = auto()    # Stage hasn't started yet
    RUNNING = auto()    # Stage is currently executing
    SUCCESS = auto()    # Stage completed successfully
    FAILED = auto()     # Stage failed after all retries exhausted
    SKIPPED = auto()    # Stage was skipped (e.g., during dry-run)


class ResourceKind(Enum):
    """Types of computational resources that can be requested by stages."""
    GPU = "gpu"         # GPU devices (e.g., NVIDIA A100s)
    CPU = "cpu"         # CPU cores
    MEMORY = "memory"   # RAM in GiB
    DISK = "disk"       # Disk space in GiB
</parameter>
</function>
