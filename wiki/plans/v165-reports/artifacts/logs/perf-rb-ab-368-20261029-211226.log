# ---------------------------------------------------------------------------
# Domain enums & value objects
# ---------------------------------------------------------------------------

# Enum representing the possible states of a pipeline stage during execution.
# Used to track progress and determine which stages succeeded/failed.
class StageStatus(Enum):
    PENDING = auto()   # Stage hasn't started yet
    RUNNING = auto()   # Stage is currently executing
    SUCCESS = auto()   # Stage completed successfully
    FAILED = auto()    # Stage failed after exhausting retries
    SKIPPED = auto()   # Stage was skipped (e.g., during dry-run)


# Enum for the types of computational resources a stage can request.
# Used by ResourceBudget to track allocation and prevent overcommitment.
class ResourceKind(Enum):
    GPU = "gpu"        # GPU devices (e.g., NVIDIA GPUs)
    CPU = "cpu"        # CPU cores
    MEMORY = "memory"  # System memory (RAM)
    DISK = "disk"      # Disk storage


# Immutable value object representing a resource requirement for a stage.
# Frozen dataclass ensures it can be used as a dictionary key and in sets.
@dataclass(frozen=True)
class ResourceRequest:
    kind: ResourceKind  # Type of resource (GPU, CPU, etc.)
    amount: float       # Quantity requested
    unit: str = "GiB"   # Unit of measurement (GiB, cores, devices, etc.)

    def scale(self, factor: float) -> ResourceRequest:
        """Return a new ResourceRequest with the amount scaled by the given factor.
        
        Useful for adjusting resource requirements based on batch size or
        other scaling factors without modifying the original request.
        """
        return ResourceRequest(
            kind=self.kind,
            amount=round(self.amount * factor, 2),
            unit=self.unit,
        )


# Configuration for checkpointing behavior during long-running stages.
# Checkpoints allow resuming from a saved state if a stage fails.
@dataclass
class CheckpointPolicy:
    enabled: bool = True                    # Whether checkpointing is active
    interval_seconds: int = 300             # Save checkpoint every N seconds
    max_kept: int = 5                       # Maximum checkpoints to retain
    base_dir: Path = field(default_factory=lambda: Path("/tmp/checkpoints"))

    def resolve_path(self, stage_name: str, epoch: int) -> Path:
        """Generate the filesystem path for a checkpoint file.
        
        Args:
            stage_name: Name of the pipeline stage
            epoch: Epoch number within the stage
            
        Returns:
            Path to the checkpoint file (e.g., /tmp/checkpoints/train/epoch_0001.pt)
        """
        slug = stage_name.lower().replace(" ", "_")
        return self.base_dir / slug / f"epoch_{epoch:04d}.pt"
</parameter>
