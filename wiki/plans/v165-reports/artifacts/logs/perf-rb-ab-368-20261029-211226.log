# -- reporting ----------------------------------------------------------
    # Provides summary information about pipeline state

    def summary(self) -> dict[str, Any]:
        """
        Returns a summary of the pipeline's current state.
        
        Returns:
            Dict with pipeline name, stage count, status per stage, and metadata
        """
        return {
            "pipeline": self.name,
            "total_stages": len(self.stages),
            "status": {k: v.name for k, v in self._status.items()},
            "metadata": dict(self.metadata),
        }


# ---------------------------------------------------------------------------
# CLI entry-point
# ---------------------------------------------------------------------------
# Demonstrates usage with a demo pipeline that has intentional validation errors

def _build_demo_pipeline() -> tuple[Pipeline, ResourceBudget]:
    """
    Creates a demo pipeline with 5 stages for testing/validation.
    
    Stages:
    1. data-ingest: Load raw data (CPU + disk)
    2. tokenize: Process text (CPU + memory)
    3. train: Model training (GPU + memory) - has intentional bad timeout
    4. evaluate: Run evaluation (GPU + memory)
    5. export-onnx: Export to ONNX format (CPU + memory)
    
    The 'train' stage has timeout=-1 to demonstrate validation catching errors.
    """
    budget = ResourceBudget(
        {
            ResourceKind.GPU: 8.0,
            ResourceKind.CPU: 64.0,
            ResourceKind.MEMORY: 256.0,
            ResourceKind.DISK: 1024.0,
        }
    )

    pipe = (
        Pipeline("training-v2")
        .set_metadata("owner", "ml-platform")
        .set_metadata("experiment", "bert-finetune-2025q4")
        .add(
            "data-ingest",
            timeout=120,
            resources=[
                ResourceRequest(ResourceKind.CPU, 4.0, "cores"),
                ResourceRequest(ResourceKind.DISK, 200.0),
            ],
            tags={"tier": "bronze"},
        )
        .add(
            "tokenize",
            timeout=300,
            depends_on=["data-ingest"],
            resources=[
                ResourceRequest(ResourceKind.CPU, 8.0, "cores"),
                ResourceRequest(ResourceKind.MEMORY, 32.0),
            ],
        )
        .add(
            "train",
            timeout=-1,          # intentional bad value for validation demo
            retries=2,
            depends_on=["tokenize"],
            resources=[
                ResourceRequest(ResourceKind.GPU, 4.0, "devices"),
                ResourceRequest(ResourceKind.MEMORY, 128.0),
            ],
            tags={"tier": "gold", "framework": "pytorch"},
        )
        .add(
            "evaluate",
            timeout=600,
            depends_on=["train"],
            resources=[
                ResourceRequest(ResourceKind.GPU, 1.0, "devices"),
                ResourceRequest(ResourceKind.MEMORY, 16.0),
            ],
        )
        .add(
            "export-onnx",
            timeout=180,
            depends_on=["evaluate"],
            resources=[
                ResourceRequest(ResourceKind.CPU, 2.0, "cores"),
                ResourceRequest(ResourceKind.MEMORY, 8.0),
            ],
        )
    )

    return pipe, budget


def main() -> None:
    """
    Main entry point for CLI execution.
    
    Demonstrates:
    1. Building a pipeline with dependencies
    2. Validating against a resource budget
    3. Running in dry-run mode
    4. Printing validation results and summary
    """
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s  %(levelname)-8s  %(message)s",
        datefmt="%H:%M:%S",
    )

    pipe, budget = _build_demo_pipeline()

    print(f"Pipeline: {pipe.name}")
    print(f"Stages:   {len(pipe.stages)}")
    print(f"Budget utilisation: {budget.utilisation()}")
    print()

    report = pipe
