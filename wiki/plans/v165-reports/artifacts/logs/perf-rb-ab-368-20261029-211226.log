# ---------------------------------------------------------------------------
# Domain enums & value objects
# ---------------------------------------------------------------------------

# Represents the possible states a pipeline stage can be in during execution.
# PENDING: Not yet started
# RUNNING: Currently executing
# SUCCESS: Completed successfully
# FAILED: Failed after exhausting all retries
# SKIPPED: Skipped (e.g., during dry-run mode)
class StageStatus(Enum):
    PENDING = auto()
    RUNNING = auto()
    SUCCESS = auto()
    FAILED = auto()
    SKIPPED = auto()


# Types of computational resources that stages can request.
# Used by ResourceBudget to track allocation and prevent overcommitment.
class ResourceKind(Enum):
    GPU = "gpu"       # GPU devices (e.g., NVIDIA A100)
    CPU = "cpu"       # CPU cores
    MEMORY = "memory" # System RAM in GiB
    DISK = "disk"     # Disk space in GiB


# Immutable value object representing a resource request for a stage.
# Each stage can have multiple ResourceRequests (e.g., needs 4 CPU cores AND 32GB RAM).
@dataclass(frozen=True)
class ResourceRequest:
    kind: ResourceKind
    amount: float
    unit: str = "GiB"

    def scale(self, factor: float) -> ResourceRequest:
        """Return a new request with amount multiplied by factor.
        
        Useful for scaling resource requirements up/down based on
        dataset size or batch size changes.
        """
        return ResourceRequest(
            kind=self.kind,
            amount=round(self.amount * factor, 2),
            unit=self.unit,
        )
