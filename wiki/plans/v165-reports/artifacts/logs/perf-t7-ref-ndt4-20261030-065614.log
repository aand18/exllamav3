            margin: 5px 0;
        }

        .btn {
            background-color: #2ecc71;
            border: none;
            color: white;
            padding: 10px 20px;
            font-size: 1.2em;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 15px;
            transition: background 0.3s;
        }

        .btn:hover {
            background-color: #27ae60;
        }

        /* Show mobile controls on small screens */
        @media (max-width: 600px) {
            .mobile-controls {
                display: grid;
            }
            .controls {
                display: none;
            }
