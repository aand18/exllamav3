    # Provides summary information about pipeline execution

    def summary(self) -> dict[str, Any]:
        """
        Returns a summary of pipeline execution status.
        Useful for logging, monitoring, or API responses.
        
        Returns:
            Dict with pipeline name, stage count, per-stage status, and metadata
        """
        return {
            "pipeline": self.name,
            "total_stages": len(self.stages),
