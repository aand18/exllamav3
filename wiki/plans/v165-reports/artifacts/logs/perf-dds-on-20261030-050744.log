Here is a Python script that draws a cute, stylized cartoon kitten using `matplotlib`. It uses basic geometric shapes (circles, ellipses, and polygons) to construct the face, ears, eyes, and whiskers.

### Prerequisites
You need `matplotlib` installed. If you don't have it, install it via:
```bash
pip install matplotlib
```

### Python Script: `cute_kitten.py`

```python
import matplotlib.pyplot as plt
import matplotlib.patches as patches
import numpy as np

def draw_cute_kitten():
    # Create a figure and axis
    fig, ax = plt.subplots(figsize=(8, 8))
    ax.set_aspect('equal')
    ax.axis('off')  # Hide the axes
    ax.set_xlim(0, 10)
    ax.set_ylim(0, 10)
    
    # Background color (soft pastel)
    fig.patch.set_facecolor('#F0F8FF')  # AliceBlue
    ax.set_facecolor('#F0F8FF')

    # --- 1. Head (Main Circle) ---
    head_center = (5, 5)
    head_radius = 3.5
    head = patches.Circle(head_center, head_radius, facecolor='#FFDAB9', edgecolor='#8B4513', linewidth=2, zorder=2)
    ax.add_patch(head)

    # --- 2. Ears (Triangles) ---
    # Left Ear
    left_ear = patches.Polygon(
        [(3.5, 7.5), (2.5, 9.5), (4.5, 8.5)],
        closed=True,
        facecolor='#FFDAB9',
        edgecolor='#8B4513',
        linewidth=2,
        zorder=1
    )
    # Inner Left Ear (Pink)
    left_ear_inner = patches.Polygon(
        [(3.7, 7.7), (3.0, 9.0), (4.2, 8.2)],
        closed=True,
        facecolor='#FFB6C1',
        edgecolor='none',
        zorder=2
    )
    ax.add_patch(left_ear)
    ax.add_patch(left_ear_inner)

    # Right Ear
    right_ear = patches.Polygon(
        [(6.5, 7.5), (7.5, 9.5), (5.5, 8.5)],
        closed=True,
        facecolor='#FFDAB9',
        edgecolor='#8B4513',
        linewidth=2,
        zorder=1
    )
    # Inner Right Ear (Pink)
    right_ear_inner = patches.Polygon(
        [(6.3, 7.7), (7.0, 9.0), (5.8, 8.2)],
        closed=True,
        facecolor='#FFB6C1',
        edgecolor='none',
        zorder=2
    )
    ax.add_patch(right_ear)
    ax.add_patch(right_ear_inner)

    # --- 3. Eyes ---
    # Left Eye
    left_eye = patches.Ellipse((3.8, 5.5), width=0.8, height=1.2, facecolor='white', edgecolor='black', linewidth=1.5, zorder=3)
    left_pupil = patches.Ellipse((3.8, 5.5), width=0.4, height=0.8, facecolor='black', zorder=4)
    left_shine = patches.Circle((3.9, 5.7), radius=0.15, facecolor='white', zorder=5)
    
    # Right Eye
    right_eye = patches.Ellipse((6.2, 5.5), width=0.8, height=1.2, facecolor='white', edgecolor='black', linewidth=1.5, zorder=3)
    right_pupil = patches.Ellipse((6.2, 5.5), width=0.4, height=0.8, facecolor='black', zorder=4)
    right_shine = patches.Circle((6.3, 5.7), radius=0.15, facecolor='white', zorder=5)

    ax.add_patch(left_eye)
    ax.add_patch(left_pupil)
    ax.add_patch(left_shine)
    ax.add_patch(right_eye)
    ax.add_patch(right_pupil)
