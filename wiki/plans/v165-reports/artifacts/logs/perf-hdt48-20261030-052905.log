Here is a Python script that draws a cute, stylized cartoon kitten using `matplotlib`. It uses basic geometric shapes (circles, ellipses, and polygons) to construct the face, ears, eyes, and whiskers.

### Prerequisites
You need `matplotlib` and `numpy` installed. If you don't have them, install them via:
```bash
pip install matplotlib numpy
```

### Python Script

```python
import matplotlib.pyplot as plt
import matplotlib.patches as patches
import numpy as np

def draw_cute_kitten():
    # Create a figure and axis
    fig, ax = plt.subplots(figsize=(8, 8))
    ax.set_aspect('equal')
    ax.axis('off')  # Hide the axes
    ax.set_xlim(-1.5, 1.5)
    ax.set_ylim(-1.5, 1.5)
    
    # Background color (soft pastel)
    ax.set_facecolor('#F0F8FF')  # AliceBlue
    fig.patch.set_facecolor('#F0F8FF')

    # --- 1. Head (Main Circle) ---
    head = patches.Circle((0, 0), 0.8, color='#FFDAB9', edgecolor='black', linewidth=2)
    ax.add_patch(head)

    # --- 2. Ears (Triangles) ---
    # Left Ear
    left_ear = patches.Polygon([[-0.6, 0.6], [-0.8, 1.2], [-0.4, 0.8]], 
                               closed=True, color='#FFDAB9', edgecolor='black', linewidth=2)
    ax.add_patch(left_ear)
    
    # Inner Left Ear (Pink)
    left_inner_ear = patches.Polygon([[-0.6, 0.6], [-0.7, 1.0], [-0.5, 0.7]], 
                                     closed=True, color='#FFB6C1', edgecolor='none')
    ax.add_patch(left_inner_ear)

    # Right Ear
    right_ear = patches.Polygon([[0.6, 0.6], [0.8, 1.2], [0.4, 0.8]], 
                                closed=True, color='#FFDAB9', edgecolor='black', linewidth=2)
    ax.add_patch(right_ear)
    
    # Inner Right Ear (Pink)
    right_inner_ear = patches.Polygon([[0.6, 0.6], [0.7, 1.0], [0.5, 0.7]], 
                                      closed=True, color='#FFB6C1', edgecolor='none')
    ax.add_patch(right_inner_ear)

    # --- 3. Eyes ---
    # White part of eyes
    left_eye = patches.Ellipse((-0.3, 0.2), 0.25, 0.35, color='white', edgecolor='black', linewidth=1.5)
    right_eye = patches.Ellipse((0.3, 0.2), 0.25, 0.35, color='white', edgecolor='black', linewidth=1.5)
    ax.add_patch(left_eye)
    ax.add_patch(right_eye)

    # Pupils (Black)
    left_pupil = patches.Ellipse((-0.3, 0.2), 0.1, 0.2, color='black')
    right_pupil = patches.Ellipse((0.3, 0.2), 0.1, 0.2, color='black')
    ax.add_patch(left_pupil)
    ax.add_patch(right_pupil)

