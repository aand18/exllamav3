### Python Script

```python
import matplotlib.pyplot as plt
import matplotlib.patches as patches
import numpy as np

def draw_cute_kitten():
    # Create a figure and axis
    fig, ax = plt.subplots(figsize=(8, 8))
    ax.set_aspect('equal')
    ax.axis('off')  # Hide the axes
    ax.set_xlim(0, 10)
    ax.set_ylim(0, 10)
    
    # Background color (soft pastel)
    ax.set_facecolor('#f0f8ff')  # AliceBlue

    # --- 1. Head (Main Circle) ---
    head_center = (5, 5)
    head_radius = 3
    head = patches.Circle(head_center, head_radius, facecolor='#FFDAB9', edgecolor='black', linewidth=2)
    ax.add_patch(head)

    # --- 2. Ears (Triangles) ---
    # Left Ear
    left_ear = patches.Polygon(
        [(3.5, 7.5), (2.5, 9.5), (4.5, 7.5)],
        closed=True,
        facecolor='#FFDAB9',
        edgecolor='black',
        linewidth=2
    )
    ax.add_patch(left_ear)
    
    # Inner Left Ear (Pink)
    left_ear_inner = patches.Polygon(
        [(3.7, 7.3), (3.0, 8.8), (4.2, 7.3)],
        closed=True,
        facecolor='#FFB6C1',
        edgecolor='none'
    )
    ax.add_patch(left_ear_inner)

    # Right Ear
    right_ear = patches.Polygon(
        [(6.5, 7.5), (7.5, 9.5), (5.5, 7.5)],
        closed=True,
        facecolor='#FFDAB9',
