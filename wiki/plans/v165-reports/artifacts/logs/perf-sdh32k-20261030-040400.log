// M: rows of A, N: cols of B, K: inner dimension
// We assume a single warp handles a 16x16x16 tile for simplicity in this example.
// In production, use larger tiles and multiple warps per block.
#define TILE_M 16
#define TILE_N 16
#define TILE_K 16

// Helper for SiLU activation: x * sigmoid(x)
__device__ __forceinline__ float silu(float x) {
    return x / (1.0f + expf(-x));
}

