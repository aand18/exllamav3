# Demonstrates pipeline usage with a demo ML training workflow

def _build_demo_pipeline() -> tuple[Pipeline, ResourceBudget]:
    """
    Creates a demo pipeline with 5 stages representing a typical ML workflow:
    1. data-ingest: Load raw data
    2. tokenize: Preprocess/tokenize the data
    3. train: Train the model (intentionally has bad config for validation demo)
    4. evaluate: Evaluate model performance
    5. export-onnx: Export to ONNX format for deployment
    
    Returns:
        Tuple of (Pipeline, ResourceBudget)
    """
    # Define cluster resource limits
    budget = ResourceBudget(
        {
            ResourceKind.GPU: 8.0,      # 8 GPU devices available
            ResourceKind.CPU: 64.0,     # 64 CPU cores
            ResourceKind.MEMORY: 256.0, # 256 GiB RAM
            ResourceKind.DISK: 1024.0,  # 1 TiB disk space
        }
    )

    # Build pipeline using fluent builder pattern
    pipe = (
        Pipeline("training-v2")
        .set_metadata("owner", "ml-platform")
        .set_metadata("experiment", "bert-finetune-2025q4")
        .add(
            "data-ingest",
            timeout=120,
            resources=[
                ResourceRequest(ResourceKind.CPU, 4.0, "cores"),
                ResourceRequest(ResourceKind.DISK, 200.0),
            ],
            tags={"tier": "bronze"},
        )
        .add(
            "tokenize",
            timeout=300,
            depends_on=["data-ingest"],
            resources=[
                ResourceRequest(ResourceKind.CPU, 8.0, "cores"),
                ResourceRequest(ResourceKind.MEMORY, 32.0),
            ],
        )
        .add(
            "train",
            timeout=-1,          # intentional bad value for validation demo
            retries=2,
            depends_on=["tokenize"],
            resources=[
                ResourceRequest(ResourceKind.GPU, 4.0, "devices"),
                ResourceRequest(ResourceKind.MEMORY, 128.0),
            ],
            tags={"tier": "gold", "framework": "pytorch"},
        )
        .add(
            "evaluate",
            timeout=600,
            depends_on=["train"],
            resources=[
                ResourceRequest(ResourceKind.GPU, 1.0, "devices"),
                ResourceRequest(ResourceKind.MEMORY, 16.0),
            ],
        )
        .add(
            "export-onnx",
            timeout=180,
            depends_on=["evaluate"],
            resources=[
                ResourceRequest(ResourceKind.CPU, 2.0, "cores"),
                ResourceRequest(ResourceKind.MEMORY, 8.0),
            ],
        )
    )

    return pipe, budget


def main() -> None:
    """
    CLI entry point that demonstrates pipeline validation and dry-run execution.
    """
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s  %(levelname)-8s  %(message)s",
        datefmt="%H:%M:%S",
    )

    pipe, budget = _build_demo_pipeline()

    print(f"Pipeline: {pipe.name}")
    print(f"Stages:   {len(pipe.stages)}")
    print(f"Budget utilisation: {budget.utilisation()}")
    print()

    # Validate all stages
    report = pipe.validate(budget)

