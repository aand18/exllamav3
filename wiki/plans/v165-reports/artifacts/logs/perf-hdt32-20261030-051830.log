# ---------------------------------------------------------------------------
# Domain enums & value objects
# ---------------------------------------------------------------------------

# Enum representing the possible states of a pipeline stage during execution.
# Used to track progress and determine which stages succeeded/failed.
class StageStatus(Enum):
    PENDING = auto()   # Stage has not started yet
    RUNNING = auto()   # Stage is currently executing
    SUCCESS = auto()   # Stage completed successfully
    FAILED = auto()    # Stage failed after exhausting retries
    SKIPPED = auto()   # Stage was skipped (e.g., dry-run mode)


# Enum representing the types of computational resources that can be
# requested by pipeline stages. Used for resource budgeting and validation.
class ResourceKind(Enum):
    GPU = "gpu"        # GPU devices (e.g., NVIDIA A100s)
    CPU = "cpu"        # CPU cores
    MEMORY = "memory"  # RAM in GiB
    DISK = "disk"      # Disk space in GiB


# Immutable value object representing a resource request for a stage.
# Frozen dataclass ensures hashability and immutability for use in sets/dicts.
@dataclass(frozen=True)
class ResourceRequest:
    kind: ResourceKind  # Type of resource (GPU, CPU, memory, disk)
    amount: float       # Quantity requested (e.g., 4.0 GPU devices)
    unit: str = "GiB"   # Unit of measurement (GiB for memory/disk, cores for CPU)

    def scale(self, factor: float) -> ResourceRequest:
        """Return a new ResourceRequest with the amount multiplied by factor.
        
        Useful for scaling resource requirements up/down based on batch size
        or other configuration parameters.
        """
        return ResourceRequest(
            kind=self.kind,
            amount=round(self.amount * factor, 2),
            unit=self.unit,
        )


# Configuration for checkpointing behavior during stage execution.
# Checkpoints allow resuming from intermediate states if a stage fails.
@dataclass
class CheckpointPolicy:
    enabled: bool = True                    # Whether checkpointing is active
    interval_seconds: int = 300             # Save checkpoint every N seconds
    max_kept: int = 5                       # Maximum number of checkpoints to retain
    base_dir: Path = field(default_factory=lambda: Path("/tmp/checkpoints"))  # Root directory for checkpoints

    def resolve_path(self, stage_name: str, epoch: int) -> Path:
        """Generate the filesystem path for a checkpoint file.
        
        Args:
            stage_name: Name of the pipeline stage
            epoch: Epoch number within the stage
            
        Returns:
            Path to the checkpoint file (e.g., /tmp/checkpoints/train/epoch_0001.pt)
        """
        slug = stage_name.lower().replace(" ", "_")
        return self.base_dir / slug / f"epoch_{epoch:04d}.pt"
