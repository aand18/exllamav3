# ---------------------------------------------------------------------------
# Domain enums & value objects
# ---------------------------------------------------------------------------

class StageStatus(Enum):
    """Tracks the lifecycle state of a pipeline stage."""
    PENDING = auto()    # Not yet started
    RUNNING = auto()    # Currently executing
    SUCCESS = auto()    # Completed successfully
    FAILED = auto()     # Failed after all retries exhausted
    SKIPPED = auto()    # Skipped (e.g., in dry-run mode)


class ResourceKind(Enum):
    """Types of computational resources that can be allocated."""
    GPU = "gpu"         # GPU devices (e.g., NVIDIA GPUs)
    CPU = "cpu"         # CPU cores
    MEMORY = "memory"   # RAM in GiB
    DISK = "disk"       # Disk storage in GiB


@dataclass(frozen=True)
class ResourceRequest:
    """
    Immutable specification of a resource requirement.
    
    Attributes:
        kind: The type of resource (GPU, CPU, MEMORY, DISK)
        amount: How much of the resource is needed
        unit: Unit of measurement (e.g., "GiB", "cores")
    """
    kind: ResourceKind
    amount: float
    unit: str = "GiB"

    def scale(self, factor: float) -> ResourceRequest:
        """
        Returns a new ResourceRequest with the amount scaled by the given factor.
        Useful for scaling resource requirements up or down.
        """
        return ResourceRequest(
            kind=self.kind,
            amount=round(self.amount * factor, 2),
            unit=self.unit,
        )


@dataclass
class CheckpointPolicy:
    """
    Configuration for checkpointing behavior during stage execution.
    
    Checkpoints allow resuming from a saved state if a stage fails,
    avoiding the need to restart from the beginning.
    
    Attributes:
        enabled: Whether checkpointing is enabled for this stage
        interval_seconds: How often to save checkpoints (in seconds)
        max_kept: Maximum number of checkpoints to retain
        base_dir: Root directory where checkpoints are stored
    """
    enabled: bool = True
    interval_seconds: int = 300
    max_kept: int = 5
    base_dir: Path = field(default_factory=lambda: Path("/tmp/checkpoints"))

    def resolve_path(self, stage_name: str, epoch: int) -> Path:
        """
        Constructs the filesystem path for a specific checkpoint.
        
        Args:
            stage_name: Name of the pipeline stage
            epoch: Epoch number within the stage
            
        Returns:
            Path to the checkpoint file (e.g., /tmp/checkpoints/train/epoch_0001.pt)
        """
        slug = stage_name.lower().replace(" ", "_")
        return self.base_dir / slug / f"epoch_{epoch:04d}.pt"
