# ---------------------------------------------------------------------------
# Domain enums & value objects
# ---------------------------------------------------------------------------

# Represents the lifecycle state of a pipeline stage during execution
class StageStatus(Enum):
    PENDING = auto()   # Stage hasn't started yet
    RUNNING = auto()   # Stage is currently executing
    SUCCESS = auto()   # Stage completed successfully
    FAILED = auto()    # Stage failed after all retries exhausted
    SKIPPED = auto()   # Stage was skipped (e.g., dry-run mode)


# Types of computational resources that can be allocated to stages
class ResourceKind(Enum):
    GPU = "gpu"        # GPU devices (e.g., NVIDIA A100s)
    CPU = "cpu"        # CPU cores
    MEMORY = "memory"  # System memory (RAM)
    DISK = "disk"      # Disk storage space


# Immutable value object representing a resource request for a stage
@dataclass(frozen=True)
class ResourceRequest:
    kind: ResourceKind      # Type of resource (GPU, CPU, etc.)
    amount: float           # Quantity requested
    unit: str = "GiB"       # Unit of measurement (GiB, cores, devices, etc.)

    def scale(self, factor: float) -> ResourceRequest:
        """Return a new ResourceRequest with amount multiplied by factor."""
        return ResourceRequest(
            kind=self.kind,
            amount=round(self.amount * factor, 2),
            unit=self.unit,
        )
</parameter>
