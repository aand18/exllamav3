# Demonstrates how to build and validate a pipeline with resource budgets

def _build_demo_pipeline() -> tuple[Pipeline, ResourceBudget]:
    """
    Creates a demo pipeline with 5 stages for testing/validation.
    
    Pipeline flow:
        data-ingest -> tokenize -> train -> evaluate -> export-onnx
    
    Note: The "train" stage has timeout=-1 intentionally to demonstrate
    validation catching misconfigured stages.
    """
    budget = ResourceBudget(
        {
            ResourceKind.GPU: 8.0,
            ResourceKind.CPU: 64.0,
            ResourceKind.MEMORY: 256.0,
            ResourceKind.DISK: 1024.0,
        }
    )
