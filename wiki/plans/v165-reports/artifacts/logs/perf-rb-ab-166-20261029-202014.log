class StageStatus(Enum):
    """
    Represents the lifecycle states of a pipeline stage.
    
    - PENDING: Stage is waiting to be executed
    - RUNNING: Stage is currently executing
    - SUCCESS: Stage completed successfully
    - FAILED: Stage failed after exhausting retries
    - SKIPPED: Stage was skipped (e.g., in dry-run mode)
    """
    PENDING = auto()
    RUNNING = auto()
    SUCCESS = auto()
    FAILED = auto()
    SKIPPED = auto()
