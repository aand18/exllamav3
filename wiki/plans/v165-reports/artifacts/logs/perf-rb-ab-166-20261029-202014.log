            if (gameOver) {
                ctx.fillStyle = 'red';
                ctx.font = '30px Arial';
                ctx.fillText('Game Over!', canvas.width / 2 - 50, canvas.height / 2);
                ctx.font = '16px Arial';
                ctx.fillText('Press Space to Restart', canvas.width / 2 - 70, canvas.height / 2 + 30);
