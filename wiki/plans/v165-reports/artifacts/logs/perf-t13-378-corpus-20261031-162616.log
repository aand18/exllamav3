### The Script

```python
import matplotlib.pyplot as plt
import matplotlib.patches as patches
import numpy as np

def draw_cute_kitten():
    # Create a figure and axis
    fig, ax = plt.subplots(figsize=(8, 8))
    ax.set_aspect('equal')
    ax.axis('off')  # Hide the axes
    ax.set_xlim(0, 10)
    ax.set_ylim(0, 10)
    
    # Background color (soft pastel)
    fig.patch.set_facecolor('#F0F8FF')  # AliceBlue
    ax.set_facecolor('#F0F8FF')

    # --- 1. Body (Ellipse) ---
    body = patches.Ellipse((5, 3.5), width=4, height=3, facecolor='#FFB6C1', edgecolor='black', linewidth=2)
    ax.add_patch(body)

    # --- 2. Head (Circle) ---
    head = patches.Circle((5, 6.5), radius=2.2, facecolor='#FFB6C1', edgecolor='black', linewidth=2)
    ax.add_patch(head)

    # --- 3. Ears (Triangles) ---
    # Left Ear
    left_ear = patches.Polygon([[3.5, 7.5], [2.5, 9.5], [4.5, 8.5]], closed=True, facecolor='#FFB6C1', edgecolor='black', linewidth=2)
    ax.add_patch(left_ear)
    # Inner Left Ear
    left_inner_ear = patches.Polygon([[3.7, 7.7], [3.0, 9.0], [4.2, 8.2]], closed=True, facecolor='#FF69B4', edgecolor='none')
    ax.add_patch(left_inner_ear)

    # Right Ear
    right_ear = patches.Polygon([[6.5, 7.5], [7.5, 9.5], [5.5, 8.5]], closed=True, facecolor='#FFB6C1', edgecolor='black', linewidth=2)
    ax.add_patch(right_ear)
    # Inner Right Ear
    right_inner_ear = patches.Polygon([[6.3, 7.7], [7.0, 9.0], [5.8, 8.2]], closed=True, facecolor='#FF69B4', edgecolor='none')
    ax.add_patch(right_inner_ear)

    # --- 4. Eyes ---
    # Left Eye
