# ---------------------------------------------------------------------------
# Domain enums & value objects
# ---------------------------------------------------------------------------

class StageStatus(Enum):
    """Tracks the lifecycle state of a pipeline stage."""
    PENDING = auto()    # Not yet started
    RUNNING = auto()    # Currently executing
    SUCCESS = auto()    # Completed successfully
    FAILED = auto()     # Failed after all retries exhausted
    SKIPPED = auto()    # Skipped (e.g., during dry-run)


class ResourceKind(Enum):
    """Types of computational resources that can be allocated."""
    GPU = "gpu"         # GPU devices (e.g., NVIDIA A100)
    CPU = "cpu"         # CPU cores
    MEMORY = "memory"   # System memory (RAM)
    DISK = "disk"       # Disk storage


@dataclass(frozen=True)
class ResourceRequest:
    """
    Immutable specification of a resource requirement.
    
    Attributes:
        kind: Type of resource (GPU, CPU, memory, disk)
        amount: Quantity needed
        unit: Unit of measurement (e.g., "GiB", "cores")
    """
    kind: ResourceKind
    amount: float
    unit: str = "GiB"

    def scale(self, factor: float) -> ResourceRequest:
        """Return a new request with amount multiplied by factor."""
        return ResourceRequest(
            kind=self.kind,
            amount=round(self.amount * factor, 2),
            unit=self.unit,
        )


@dataclass
class CheckpointPolicy:
    """
    Configuration for checkpointing behavior during long-running stages.
    
    Attributes:
        enabled: Whether checkpointing is active
        interval_seconds: How often to save checkpoints
        max_kept: Maximum number of checkpoints to retain
        base_dir: Directory where checkpoints are stored
    """
    enabled: bool = True
    interval_seconds: int = 300
    max_kept: int = 5
    base_dir: Path = field(default_factory=lambda: Path("/tmp/checkpoints"))

    def resolve_path(self, stage_name: str, epoch: int) -> Path:
        """Generate the filesystem path for a specific checkpoint."""
        slug = stage_name.lower().replace(" ", "_")
        return self.base_dir / slug / f"epoch_{epoch:04d}.pt"
</parameter>
