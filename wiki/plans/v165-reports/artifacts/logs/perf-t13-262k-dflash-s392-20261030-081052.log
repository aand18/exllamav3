Here is a Python script that draws a cute, stylized cartoon kitten using `matplotlib`. It uses basic geometric shapes (circles, ellipses, and lines) to construct the face, ears, eyes, and whiskers.

### Prerequisites
You need to have `matplotlib` and `numpy` installed. If you don't have them, install them via:
```bash
pip install matplotlib numpy
```

### Python Script

```python
import matplotlib.pyplot as plt
import numpy as np

def draw_cute_kitten():
    # Create a figure and axis
    fig, ax = plt.subplots(figsize=(8, 8))
    ax.set_aspect('equal')
    ax.axis('off')  # Hide the axes
    ax.set_xlim(-10, 10)
    ax.set_ylim(-10, 10)
    
    # Colors
    fur_color = '#F4A460'  # Sandy brown
    inner_ear_color = '#FFB6C1'  # Light pink
    eye_color = '#2E8B57'  # Sea green
    pupil_color = 'black'
    nose_color = '#FF69B4'  # Hot pink
    whisker_color = 'black'

    # 1. Draw the Head (Large Circle)
    head = plt.Circle((0, 0), 6, color=fur_color, zorder=1)
    ax.add_patch(head)

    # 2. Draw the Ears (Triangles)
    # Left Ear
    left_ear = plt.Polygon([(-4, 4), (-6, 8), (-2, 6)], color=fur_color, zorder=2)
    ax.add_patch(left_ear)
    # Inner Left Ear
    left_inner_ear = plt.Polygon([(-4.5, 4.5), (-5.5, 7), (-3.5, 5.5)], color=inner_ear_color, zorder=3)
    ax.add_patch(left_inner_ear)

    # Right Ear
    right_ear = plt.Polygon([(4, 4), (6, 8), (2, 6)], color=fur_color, zorder=2)
    ax.add_patch(right_ear)
    # Inner Right Ear
    right_inner_ear = plt.Polygon([(4.5, 4.5), (5.5, 7), (3.5, 5.5)], color=inner_ear_color, zorder=3)
    ax.add_patch(right_inner_ear)

    # 3. Draw the Eyes
    # Left Eye
    left_eye = plt.Circle((-2.5, 1), 1.2, color='white', zorder=4)
    ax.add_patch(left_eye)
    left_pupil = plt.Circle((-2.5, 1), 0.6, color=pupil_color, zorder=5)
    ax.add_patch(left_pupil)
    # Eye shine (white dot)
    left_shine = plt.Circle((-2.7, 1.2), 0.2, color='white', zorder=6)
    ax.add_patch(left_shine)

    # Right Eye
    right_eye = plt.Circle((2.5, 1), 1.2, color='white', zorder=4)
    ax.add_patch(right_eye)
    right_pupil = plt.Circle((2.5, 1), 0.6, color=pupil_color, zorder=5)
    ax.add_patch(right_pupil)
    # Eye shine
    right_shine = plt.Circle((2.3, 1.2), 0.2, color='white', zorder=6)
    ax.add_patch(right_shine)

    # 4. Draw the Nose (Small Triangle)
    nose = plt.Polygon([(0, -1), (-0.5, -0.5), (0.5, -0.5)], color=nose_color, zorder=4)
    ax.add_patch(nose)

    # 5. Draw the Mouth (Smile)
    # Using a simple arc or line segments for a cute smile
    theta = np.linspace(0, np.pi, 100)
    x_smile = 1.5 * np.cos(theta)
    y_smile = -1.5 + 0.5 * np.sin(theta)
    ax.plot(x_smile, y_smile, color='black', linewidth=2, zorder=4)

    # 6. Draw Whiskers
