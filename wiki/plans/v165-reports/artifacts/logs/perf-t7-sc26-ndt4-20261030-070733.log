# -- reporting ----------------------------------------------------------
    # Provides summary information about pipeline state

    def summary(self) -> dict[str, Any]:
        """
        Returns a summary of the pipeline state for logging/reporting.
        
        Returns:
            Dict with pipeline name, stage count, status of each stage,
            and any metadata that was set.
        """
