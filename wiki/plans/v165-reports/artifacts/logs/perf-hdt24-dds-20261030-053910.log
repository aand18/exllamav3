class StageStatus(Enum):
    PENDING = auto()
    RUNNING = auto()
    SUCCESS = auto()
    FAILED = auto()
    SKIPPED = auto()


class ResourceKind(Enum):
    GPU = "gpu"
    CPU = "cpu"
    MEMORY = "memory"
    DISK = "disk"


@dataclass(frozen=True)
class ResourceRequest:
    kind: ResourceKind
    amount: float
    unit: str = "GiB"

    def scale(self, factor: float) -> ResourceRequest:
        return ResourceRequest(
            kind=self.kind,
            amount=round(self.amount * factor, 2),
            unit=self.unit,
        )


@dataclass
class CheckpointPolicy:
    enabled: bool = True
    interval_seconds: int = 300
    max_kept: int = 5
    base_dir: Path = field(default_factory=lambda: Path("/tmp/checkpoints"))

    def resolve_path(self, stage_name: str, epoch: int) -> Path:
        slug = stage_name.lower().replace(" ", "_")
        return self.base_dir / slug / f"epoch_{epoch:04d}.pt"
