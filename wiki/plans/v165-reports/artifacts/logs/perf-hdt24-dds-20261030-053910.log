You need `matplotlib` and `numpy` installed. If you don't have them, install them via:
```bash
pip install matplotlib numpy
```

### Python Script

```python
import matplotlib.pyplot as plt
import matplotlib.patches as patches
import numpy as np

def draw_cute_kitten():
    # Create a figure and axis
    fig, ax = plt.subplots(figsize=(8, 8))
    ax.set_aspect('equal')
    ax.axis('off')  # Hide the axes
    ax.set_xlim(0, 10)
    ax.set_ylim(0, 10)
    
    # Background color (soft pastel)
    fig.patch.set_facecolor('#F0F8FF')  # AliceBlue
    ax.set_facecolor('#F0F8FF')

    # --- 1. Head (Main Circle) ---
    head_center = (5, 5)
    head_radius = 3
    head = patches.Circle(head_center, head_radius, facecolor='#FFDAB9', edgecolor='black', linewidth=2)
    ax.add_patch(head)

    # --- 2. Ears (Triangles) ---
    # Left Ear
    left_ear = patches.Polygon(
        [(3.5, 7.5), (2.5, 9.5), (4.5, 8.5)],
        closed=True, facecolor='#FFDAB9', edgecolor='black', linewidth=2
    )
    ax.add_patch(left_ear)
    
    # Inner Left Ear (Pink)
    inner_left_ear = patches.Polygon(
        [(3.7, 7.7), (3.0, 9.0), (4.0, 8.2)],
        closed=True, facecolor='#FFB6C1', edgecolor='none'
    )
    ax.add_patch(inner_left_ear)

    # Right Ear
    right_ear = patches.Polygon(
        [(6.5, 7.5), (7.5, 9.5), (5.5, 8.5)],
        closed=True, facecolor='#FFDAB9', edgecolor='black', linewidth=2
    )
    ax.add_patch(right_ear)
    
    # Inner Right Ear (Pink)
    inner_right_ear = patches.Polygon(
        [(6.3, 7.7), (7.0, 9.0), (6.0, 8.2)],
        closed=True, facecolor='#FFB6C1', edgecolor='none'
    )
    ax.add_patch(inner_right_ear)

    # --- 3. Eyes ---
    # Left Eye
    left_eye = patches.Ellipse((3.8, 5.5), width=0.8, height=1.2, facecolor='white', edgecolor='black', linewidth=1.5)
    ax.add_patch(left_eye)
    # Left Pupil
    left_pupil = patches.Ellipse((3.8, 5.5), width=0.4, height=0.8, facecolor='black')
    ax.add_patch(left_pupil)
    # Left Eye Highlight
    left_highlight = patches.Circle((3.9, 5.7), radius=0.1, facecolor='white')
    ax.add_patch(left_highlight)

    # Right Eye
    right_eye = patches.Ellipse((6.2, 5.5), width=0.8, height=1.2, facecolor='white', edgecolor='black', linewidth=1.5)
    ax.add_patch(right_eye)
    # Right Pupil
    right_pupil = patches.Ellipse((6.2, 5.5), width=0.4, height=0.8, facecolor='black')
    ax.add_patch(right_pupil)
    # Right Eye Highlight
    right_highlight = patches.Circle((6.3, 5.7), radius=0.1, facecolor='white')
    ax.add_patch(right_highlight)

    # --- 4. Nose ---
    # Small triangle nose
