# ---------------------------------------------------------------------------
# Domain enums & value objects
# ---------------------------------------------------------------------------

# StageStatus represents the lifecycle state of a pipeline stage.
# Stages transition through these states during execution:
#   PENDING -> RUNNING -> SUCCESS/FAILED/SKIPPED
class StageStatus(Enum):
    PENDING = auto()      # Stage is waiting to be executed
    RUNNING = auto()        # Stage is currently executing
    SUCCESS = auto()        # Stage completed successfully
    FAILED = auto()         # Stage failed after exhausting retries
    SKIPPED = auto()        # Stage was skipped (e.g., in dry-run mode)


# ResourceKind identifies the type of computational resource needed.
# Used by ResourceBudget to track allocations and validate feasibility.
class ResourceKind(Enum):
    GPU = "gpu"       # GPU devices (e.g., NVIDIA A100)
    CPU = "cpu"       # CPU cores
    MEMORY = "memory" # RAM in GiB
    DISK = "disk"     # Disk space in GiB


# ResourceRequest represents a single resource requirement for a stage.
# Immutable (frozen=True) to prevent accidental modification.
@dataclass(frozen=True)
class ResourceRequest:
    kind: ResourceKind  # Type of resource (GPU, CPU, etc.)
    amount: float       # Quantity requested (e.g., 4.0 GPU devices)
    unit: str = "GiB"   # Unit of measurement (defaults to GiB)

    def scale(self, factor: float) -> ResourceRequest:
        """
        Returns a new ResourceRequest with amount multiplied by factor.
        Useful for scaling resource requirements up/down (e.g., batch size).
        """
        return ResourceRequest(
            kind=self.kind,
            amount=round(self.amount * factor, 2),
            unit=self.unit,
        )


# CheckpointPolicy defines how checkpoints are saved during training.
# Checkpoints allow resuming from a specific point if training fails.
@dataclass
class CheckpointPolicy:
    enabled: bool = True              # Whether checkpointing is enabled
    interval_seconds: int = 300       # Save checkpoint every N seconds
    max_kept: int = 5                 # Maximum number of checkpoints to retain
    base_dir: Path = field(default_factory=lambda: Path("/tmp/checkpoints"))  # Root directory for checkpoints

    def resolve_path(self, stage_name: str, epoch: int) -> Path:
        """
        Constructs the filesystem path for a checkpoint file.
        Format: <base_dir>/<stage_slug>/epoch_<epoch_number>.pt
        Example: /tmp/checkpoints/train/epoch_0001.pt
        """
        slug = stage_name.lower().replace(" ", "_")  # Normalize stage name
        return self.base_dir / slug / f"epoch_{epoch:04d}.pt"
</parameter>
</function>
</tool_call>
