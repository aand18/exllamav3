# ---------------------------------------------------------------------------
# Domain enums & value objects
# ---------------------------------------------------------------------------

# StageStatus represents the lifecycle state of a pipeline stage.
# PENDING: stage hasn't started yet
# RUNNING: stage is currently executing
# SUCCESS: stage completed successfully
# FAILED: stage failed after exhausting retries
# SKIPPED: stage was skipped (e.g., in dry-run mode)
class StageStatus(Enum):
    PENDING = auto()
    RUNNING = auto()
    SUCCESS = auto()
    FAILED = auto()
    SKIPPED = auto()


# ResourceKind identifies the type of computational resource a stage needs.
# GPU: GPU devices (e.g., NVIDIA GPUs for training)
# CPU: CPU cores for compute-bound tasks
# MEMORY: RAM in GiB
# DISK: Disk space in GiB
class ResourceKind(Enum):
    GPU = "gpu"
    CPU = "cpu"
    MEMORY = "memory"
    DISK = "disk"


# ResourceRequest represents a single resource requirement for a stage.
# It's immutable (frozen=True) to prevent accidental mutation during validation.
# The scale() method allows adjusting requirements proportionally (e.g., for scaling up).
@dataclass(frozen=True)
class ResourceRequest:
    kind: ResourceKind
    amount: float
    unit: str = "GiB"

    def scale(self, factor: float) -> ResourceRequest:
        """Returns a new ResourceRequest with amount multiplied by factor."""
        return ResourceRequest(
            kind=self.kind,
            amount=round(self.amount * factor, 2),
            unit=self.unit,
        )
