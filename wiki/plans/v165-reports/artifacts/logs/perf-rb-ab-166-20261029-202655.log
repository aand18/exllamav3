# ---------------------------------------------------------------------------
# Domain enums & value objects
# ---------------------------------------------------------------------------

# Represents the lifecycle states of a pipeline stage.
# PENDING: Not yet started
# RUNNING: Currently executing
# SUCCESS: Completed successfully
# FAILED: Exhausted all retry attempts
# SKIPPED: Skipped during dry-run mode
class StageStatus(Enum):
    PENDING = auto()
    RUNNING = auto()
    SUCCESS = auto()
    FAILED = auto()
    SKIPPED = auto()


# Types of computational resources that stages can request.
# GPU: Graphics processing units (for ML training)
# CPU: Processor cores
# MEMORY: RAM in GiB
# DISK: Storage space in GiB
class ResourceKind(Enum):
    GPU = "gpu"
    CPU = "cpu"
    MEMORY = "memory"
    DISK = "disk"


# Immutable value object representing a single resource requirement.
# Example: ResourceRequest(ResourceKind.GPU, 4.0, "devices") means 4 GPU devices needed.
@dataclass(frozen=True)
class ResourceRequest:
    kind: ResourceKind
    amount: float
    unit: str = "GiB"

    def scale(self, factor: float) -> ResourceRequest:
        """Returns a new request with amount multiplied by factor.
        
        Used when scaling resource requirements up/down based on batch size
        or other configuration parameters.
        """
        return ResourceRequest(
            kind=self.kind,
            amount=round(self.amount * factor, 2),
            unit=self.unit,
        )


# Configuration for checkpointing behavior during stage execution.
# Checkpoints allow resuming from a saved state if a stage fails.
@dataclass
class CheckpointPolicy:
    enabled: bool = True          # Whether to save checkpoints during execution
    interval_seconds: int = 300   # How often to save checkpoints (seconds)
    max_kept: int = 5             # Maximum number of checkpoints to retain
    base_dir: Path = field(default_factory=lambda: Path("/tmp/checkpoints"))  # Root directory for checkpoints

    def resolve_path(self, stage_name: str, epoch: int) -> Path:
        """Computes the filesystem path for a checkpoint file.
        
        Args:
            stage_name: Name of the pipeline stage
            epoch: Epoch number (0-indexed)
            
        Returns:
            Path like /tmp/checkpoints/data_ingest/epoch_0000.pt
        """
        slug = stage_name.lower().replace(" ", "_")
        return self.base_dir / slug / f"epoch_{epoch:04d}.pt"
