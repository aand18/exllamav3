import matplotlib.pyplot as plt
import numpy as np

def draw_cute_kitten():
    """
    Draws a cute kitten using matplotlib patches and shapes.
    """
    fig, ax = plt.subplots(figsize=(8, 8))
    ax.set_aspect('equal')
    ax.set_xlim(0, 10)
    ax.set_ylim(0, 10)
    ax.axis('off')  # Hide axes for a clean picture

    # --- Body ---
    # Main body ellipse
    body = plt.Circle((5, 4), 2.5, color='#F5F5DC', edgecolor='black', linewidth=2)
    ax.add_patch(body)

    # --- Head ---
    # Head circle
    head = plt.Circle((5, 7), 1.5, color='#F5F5DC', edgecolor='black', linewidth=2)
    ax.add_patch(head)

    # --- Ears ---
    # Left ear
    left_ear = plt.Polygon([[4.5, 7.5], [4.0, 8.5], [5.0, 8.0]], color='#F5F5DC', edgecolor='black', linewidth=2)
    ax.add_patch(left_ear)
    # Inner left ear (pink)
    inner_left_ear = plt.Polygon([[4.5, 7.5], [4.2, 8.2], [4.8, 7.8]], color='#FFB6C1', edgecolor='black', linewidth=1)
    ax.add_patch(inner_left_ear)

    # Right ear
    right_ear = plt.Polygon([[5.5, 7.5], [6.0, 8.5], [5.0, 8.0]], color='#F5F5DC', edgecolor='black', linewidth=2)
    ax.add_patch(right_ear)
    # Inner right ear (pink)
    inner_right_ear = plt.Polygon([[5.5, 7.5], [5.8, 8.2], [5.2, 7.8]], color='#FFB6C1', edgecolor='black', linewidth=1)
    ax.add_patch(inner_right_ear)

    # --- Eyes ---
    # Left eye
    left_eye = plt.Circle((4.5, 7.2), 0.15, color='black')
    ax.add_patch(left_eye)
    # Right eye
    right_eye = plt.Circle((5.5, 7.2), 0.15, color='black')
