# -- reporting ----------------------------------------------------------
    # Provides a summary of pipeline state for logging/debugging

    def summary(self) -> dict[str, Any]:
        """
        Returns a summary dict of the pipeline's current state.
        
        Returns:
            Dict with pipeline name, stage count, status map, and metadata
            
        Example output:
            {
                "pipeline": "training-v2",
                "total_stages": 5,
                "status": {"data-ingest": "SUCCESS", "train": "FAILED"},
                "metadata": {"owner": "ml-platform"}
            }
        """
        return {
            "pipeline": self.name,
            "total_stages": len(self.stages),
            "status": {k: v.name for k, v in self._status.items()},
            "metadata": dict(self.metadata),
        }
