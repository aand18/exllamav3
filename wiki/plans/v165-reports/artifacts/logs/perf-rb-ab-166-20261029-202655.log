# ---------------------------------------------------------------------------
# Domain enums & value objects
# ---------------------------------------------------------------------------
# These enums define the "vocabulary" of the pipeline system:
# - StageStatus: lifecycle states a stage can be in (pending → running → success/failed)
# - ResourceKind: types of compute resources the pipeline can request

class StageStatus(Enum):
    """Represents the lifecycle state of a pipeline stage."""
    PENDING = auto()   # Not yet started
    RUNNING = auto()   # Currently executing
    SUCCESS = auto()   # Completed successfully
    FAILED = auto()    # Failed after exhausting retries
    SKIPPED = auto()   # Skipped (e.g., in dry-run mode)


class ResourceKind(Enum):
    """Types of resources a stage can request. Values are used for logging."""
    GPU = "gpu"        # GPU devices (e.g., 4 GPUs)
    CPU = "cpu"        # CPU cores
    MEMORY = "memory"  # RAM in GiB
    DISK = "disk"      # Disk space in GiB


@dataclass(frozen=True)
class ResourceRequest:
    """
    An immutable request for a specific amount of a resource.
    
    Attributes:
        kind: The type of resource (GPU, CPU, memory, disk)
        amount: How much of the resource is needed (e.g., 4.0 GPU devices)
        unit: Human-readable unit for display (e.g., "GiB", "cores")
    """
    kind: ResourceKind
    amount: float
    unit: str = "GiB"

    def scale(self, factor: float) -> ResourceRequest:
        """
        Returns a new ResourceRequest with the amount multiplied by `factor`.
        Useful for scaling resource needs up/down (e.g., doubling GPU allocation).
        """
        return ResourceRequest(
            kind=self.kind,
            amount=round(self.amount * factor, 2),
            unit=self.unit,
        )


@dataclass
class CheckpointPolicy:
    """
    Configuration for checkpointing behavior during a stage's execution.
    
    Attributes:
        enabled: Whether checkpointing is enabled for this stage
        interval_seconds: How often to save checkpoints (in seconds)
        max_kept: Maximum number of checkpoints to retain (older ones are deleted)
        base_dir: Root directory where checkpoints are stored
    """
    enabled: bool = True
    interval_seconds: int = 300
    max_kept: int = 5
    base_dir: Path = field(default_factory=lambda: Path("/tmp/checkpoints"))

    def resolve_path(self, stage_name: str, epoch: int) -> Path:
        """
        Computes the filesystem path for a checkpoint file.
        
        Example: resolve_path("train", 42) → /tmp/checkpoints/train/epoch_0042.pt
        """
        slug = stage_name.lower().replace(" ", "_")
        return self.base_dir / slug / f"epoch_{epoch:04d}.pt"
</parameter>
