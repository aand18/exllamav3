# ---------------------------------------------------------------------------
# Domain enums & value objects
# ---------------------------------------------------------------------------

# StageStatus represents the lifecycle state of a pipeline stage.
# PENDING: stage hasn't started yet
# RUNNING: stage is currently executing
# SUCCESS: stage completed successfully
# FAILED: stage failed after exhausting retries
# SKIPPED: stage was skipped (e.g., in dry-run mode)
class StageStatus(Enum):
    PENDING = auto()
    RUNNING = auto()
    SUCCESS = auto()
    FAILED = auto()
    SKIPPED = auto()


# ResourceKind identifies the type of computational resource needed.
# Used by ResourceBudget to track allocations and validate feasibility.
class ResourceKind(Enum):
    GPU = "gpu"      # GPU devices (e.g., NVIDIA GPUs for training)
    CPU = "cpu"      # CPU cores for data processing
    MEMORY = "memory"  # RAM in GiB
    DISK = "disk"    # Disk space in GiB


# ResourceRequest is an immutable (frozen) value object representing
# a single resource requirement. Frozen=True ensures immutability,
# making it safe to use as a dictionary key or in sets.
@dataclass(frozen=True)
class ResourceRequest:
    kind: ResourceKind   # Type of resource (GPU, CPU, etc.)
    amount: float        # Quantity requested (e.g., 4.0 GPU devices)
    unit: str = "GiB"    # Unit of measurement (defaults to GiB)

    def scale(self, factor: float) -> ResourceRequest:
        """
        Returns a new ResourceRequest with the amount multiplied by factor.
        Useful for scaling resource requirements (e.g., doubling GPU count).
        """
        return ResourceRequest(
            kind=self.kind,
            amount=round(self.amount * factor, 2),
            unit=self.unit,
        )


# CheckpointPolicy defines how checkpoints are saved during a stage.
# Checkpoints allow resuming from a saved state if a stage fails.
@dataclass
class CheckpointPolicy:
    enabled: bool = True              # Whether checkpointing is enabled
    interval_seconds: int = 300       # Save checkpoint every N seconds
    max_kept: int = 5                 # Keep at most N checkpoints (older ones deleted)
    base_dir: Path = field(default_factory=lambda: Path("/tmp/checkpoints"))  # Root directory

    def resolve_path(self, stage_name: str, epoch: int) -> Path:
        """
        Computes the filesystem path for a checkpoint file.
        Format: <base_dir>/<stage_slug>/epoch_<epoch_number>.pt
        Example: /tmp/checkpoints/data_ingest/epoch_0001.pt
        """
        slug = stage_name.lower().replace(" ", "_")  # Convert name to filesystem-safe slug
        return self.base_dir / slug / f"epoch_{epoch:04d}.pt"
</parameter>
</function>
