    # Provides summary information about pipeline execution

    def summary(self) -> dict[str, Any]:
        """
        Returns a summary of the pipeline state.
        
        Returns:
            Dict with pipeline name, stage count, status of each stage,
            and metadata. Useful for logging or API responses.
        """
