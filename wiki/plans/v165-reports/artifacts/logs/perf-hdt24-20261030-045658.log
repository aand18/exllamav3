    ax.add_patch(left_highlight)
    ax.add_patch(right_highlight)

    # --- 4. Nose ---
    # Small triangle nose
    nose = plt.Polygon([(0, -1), (-0.5, -0.5), (0.5, -0.5)], color='#FF69B4', ec='black', lw=1, zorder=3)
