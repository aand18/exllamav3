import matplotlib.pyplot as plt
import numpy as np

def draw_cute_kitten():
    # Create a figure and axis
    fig, ax = plt.subplots(figsize=(8, 8))
    ax.set_aspect('equal')
    ax.axis('off')  # Hide the axes
    ax.set_xlim(-10, 10)
    ax.set_ylim(-10, 10)
    ax.set_facecolor('#E0F7FA')  # Light blue background

    # --- 1. Head (Main Circle) ---
    head = plt.Circle((0, 0), 6, color='#FFD700', ec='black', lw=2, zorder=2)
    ax.add_patch(head)

    # --- 2. Ears (Triangles) ---
    # Left Ear
    left_ear = plt.Polygon([(-4, 4), (-6, 8), (-2, 6)], color='#FFD700', ec='black', lw=2, zorder=1)
    ax.add_patch(left_ear)
    # Inner Ear (Pink)
    left_inner_ear = plt.Polygon([(-4, 4), (-5, 6.5), (-3, 5)], color='#FFB6C1', ec='none', zorder=2)
    ax.add_patch(left_inner_ear)

    # Right Ear
    right_ear = plt.Polygon([(4, 4), (6, 8), (2, 6)], color='#FFD700', ec='black', lw=2, zorder=1)
    ax.add_patch(right_ear)
    # Inner Ear (Pink)
    right_inner_ear = plt.Polygon([(4, 4), (5, 6.5), (3, 5)], color='#FFB6C1', ec='none', zorder=2)
    ax.add_patch(right_inner_ear)

    # --- 3. Eyes ---
    # White part of eyes
    left_eye_white = plt.Circle((-2.5, 1), 1.2, color='white', ec='black', lw=1.5, zorder=3)
    right_eye_white = plt.Circle((2.5, 1), 1.2, color='white', ec='black', lw=1.5, zorder=3)
    ax.add_patch(left_eye_white)
    ax.add_patch(right_eye_white)

    # Pupils (Black)
    left_pupil = plt.Circle((-2.5, 1), 0.6, color='black', zorder=4)
