# -- reporting ----------------------------------------------------------
    # Provides a summary of pipeline state for logging/monitoring

    def summary(self) -> dict[str, Any]:
        """
        Returns a summary dict for logging and monitoring.
        
        Returns:
            Dict with pipeline name, stage count, current statuses, and metadata
        """
        return {
            "pipeline": self.name,
            "total_stages": len(self.stages),
            "status": {k: v.name for k, v in self._status.items()},
            "metadata": dict(self.metadata),
        }
