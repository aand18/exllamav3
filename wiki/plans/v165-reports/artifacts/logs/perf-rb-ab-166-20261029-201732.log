# ---------------------------------------------------------------------------
# Domain enums & value objects
# ---------------------------------------------------------------------------

# Represents the lifecycle states of a pipeline stage during execution.
# PENDING: stage hasn't started yet
# RUNNING: stage is currently executing
# SUCCESS: stage completed successfully
# FAILED: stage failed after exhausting retries
# SKIPPED: stage was skipped (e.g., during dry-run mode)
class StageStatus(Enum):
    PENDING = auto()
    RUNNING = auto()
    SUCCESS = SUCCESS = auto()
    FAILED = FAILED = auto()
    SKIPPED = SKIPPED = auto()
</parameter>
